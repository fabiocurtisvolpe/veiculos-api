          "raw": "{\n  \"marca\": \"Ford\",\n  \"modelo\": \"Fiesta Titanium\",\n  \"ano\": 2019,\n  \"cor\": \"Preto\",\n  \"placa\": \"ABC1234\",\n  \"precoEmReais\": 48000.00\n}"
