        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marca\": \"Ford\",\n  \"modelo\": \"Fiesta\",\n  \"ano\": 2018,\n  \"cor\": \"Prata\",\n  \"placa\": \"ABC1234\",\n  \"precoEmReais\": 45000.00\n}"
        },
        "url": {
